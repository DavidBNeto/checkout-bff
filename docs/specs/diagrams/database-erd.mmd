erDiagram
    SHOPPING_CART ||--o{ CART_ITEM : contains
    SHOPPING_CART ||--o{ CART_PAYMENT_METHOD : "has"
    CART_PAYMENT_METHOD }|--|| PAYMENT_METHOD : "method"
    CART_ITEM }|--|| PRODUCT : references
    SHOPPING_CART ||--o{ CHECKOUT_OPERATION : "initiates"
    CHECKOUT_OPERATION ||--o{ PAYMENT_ATTEMPT : "has"
    OUTBOX_EVENT ||--o{ CHECKOUT_OPERATION : "triggers"

    SHOPPING_CART {
        bigint id PK
        uuid public_id UK
        numeric(10,2) price
        varchar(50) status "PENDING, PAID, EXPIRED, CANCELLED"
        timestamp paid_at
        timestamp created_at
    }

    CART_ITEM {
        bigint id PK
        bigint cart_id FK
        bigint product_id FK
        int quantity
        numeric(10,2) unit_price
        varchar(100) product_slug
        varchar(200) product_name
        text product_description
        varchar(3) currency
        %% Unique constraint: (cart_id, product_id)
    }

    PRODUCT {
        bigint id PK
        varchar(100) slug UK
        varchar(200) name
        text description
        numeric(10,2) price
        varchar(3) currency
        boolean active
    }

    PAYMENT_METHOD {
        bigint id PK
        varchar(100) name UK
        varchar(100) normalized_name UK
        boolean active
    }

    CART_PAYMENT_METHOD {
        bigint id PK
        bigint cart_id FK
        bigint payment_method_id FK
        varchar(100) payment_method_name
        %% Unique constraint: (cart_id, payment_method_id)
    }

    CHECKOUT_OPERATION {
        uuid id PK
        bigint cart_id FK
        varchar(50) status "PENDING, PROCESSING, APPROVED, DECLINED, FAILED"
        bigint payment_method_id FK
        varchar(100) payment_method_name
        varchar(20) payment_method_type "CREDIT_CARD, DEBIT_CARD, PIX"
        text payment_data_snapshot "JSON"
        numeric(10,2) amount
        varchar(3) currency
        varchar(36) idempotency_key UK
        timestamp created_at
        timestamp completed_at
    }

    PAYMENT_ATTEMPT {
        bigint id PK
        uuid checkout_id FK
        varchar(50) status "APPROVED, DECLINED, FAILED"
        varchar(100) authorization_code
        varchar(4) masked_card_last4
        text pix_code
        text failure_reason
        timestamp attempted_at
    }

    OUTBOX_EVENT {
        bigint id PK
        varchar(36) event_id UK
        varchar(100) event_type
        jsonb payload
        varchar(200) routing_key
        varchar(100) exchange
        timestamp created_at
        timestamp published_at
        int retry_count
        text last_error
    }